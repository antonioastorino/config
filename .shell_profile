setopt histignorealldups
alias ll="ls -lah"
alias ldd="otool -L"
# Enable autocomplete for git
autoload -Uz compinit && compinit

__prompt_command() {
    new_line() {
      printf "\n$USER@$HOST - "
    }
    # from http://wiki.archlinux.org/index.php/Color_Bash_Prompt
    local NONE="\033[0m" # unsets color to term's fg color

    # regular colors
    local K="\033[0;95m" # black
    local R="\033[0;31m" # red
    local G="\033[0;32m" # green
    local Y="\033[0;33m" # yellow
    local B="\033[0;34m" # blue
    local M="\033[0;35m" # magenta
    local C="\033[0;36m" # cyan
    local GRAY="\033[0;37m" 
    local DARK_GRAY="\033[0;90m"

    # emphasized (bolded) colors
    local EMK="\033[1;95m"
    local EMR="\033[1;31m"
    local EMG="\033[1;32m"
    local EMY="\033[1;33m"
    local EMB="\033[1;34m"
    local EMM="\033[1;35m"
    local EMC="\033[1;36m"
    local GRAY_BOLD="\033[1;37m"
    local DARK_GRAY_BOLD="\033[1;90m"

    # Source the git prompt
    . ~/config/.git_prompt.zsh
    export PS1="$(git_info)$(new_line)%2/ > "
}

__ptla_power_on() {
    pushd ~/dev/instruments_api
    source scripts/install/linux-setup.sh
    pushd instruments_api
    python instruments_api/mainframes/ptla_mainframe/ep_ptla_io_card.py
    popd
    popd
}

__lab_mnt() {
    local REMOTE="effectengineer@EHV-LAB-001"

    typeset -A PAIRS=(
        ["/c:/data/OPM_FREQUENCY_TRACKING"]="$HOME/dev/lab_instruments_api"
        ["/c:/Users/effectengineer/Documents/ptla"]="$HOME/dev/lab_ptla"
        ["/c:/Users/effectengineer/antonio/instruments_api"]="$HOME/dev/lab_data"
    )

    for src mnt in ${(kv)PAIRS}; do
        echo "Unmounting ${mnt}"
        umount "${mnt}" 2>/dev/null
        echo "Creating ${mnt}"
        mkdir -p "${mnt}"
        echo "Mounting ${mnt}"
        sshfs "${REMOTE}:${src}" "${mnt}"
    done
}

